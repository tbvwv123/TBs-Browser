{
  "id": "smoke-fixture",
  "name": "스모크 스크립트",
  "version": "1.0.0",
  "description": "스모크 시험용",
  "author": "TB's Browser",
  "matches": ["http://127.0.0.1:*"],
  "run_at": "document_end",
  "js": ["main.js"],
