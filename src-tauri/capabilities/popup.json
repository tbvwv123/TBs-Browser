{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popup-only",
  "description": "콘텐츠 위에 뜨는 팝업 창(자동완성, 다운로드, 메뉴, 북마크, 접힌 상태의 확장 패널, 설치 확인)에는 그 화면이 쓰는 명령만 허용한다.",
  "webviews": [
    "popup"
  ],
  "permissions": [
    "core:event:default",
    "allow-popup-pick",
    "allow-popup-hide",
    "allow-download-open",
    "allow-download-show",
    "allow-download-cancel",
    "allow-popup-menu-pick",
    "allow-ext-list",
    "allow-ext-install-confirm",
    "allow-ext-set-enabled",
    "allow-ext-set-pinned",
    "allow-ext-remove",
    "allow-ext-open-popup",
    "allow-ext-open-options",
    "allow-scripts-list",
    "allow-script-set-enabled",
    "allow-script-open-settings",
    "allow-script-run-action",
    "allow-script-set-pinned",
    "allow-scripts-reload",
    "allow-scripts-open-folder",
    "allow-popup-fit",
    "allow-ext-install-pick",
    "allow-adblock-status",
    "allow-adblock-set-site",
    "allow-adblock-reload",
    "allow-run-shortcut"
  ]
}
