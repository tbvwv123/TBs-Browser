{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui-only",
  "description": "앱 명령은 UI 웹뷰에만 허용한다. windows가 아니라 webviews로 범위를 잡아야 같은 창의 콘텐츠 웹뷰가 빠진다.",
  "webviews": [
    "ui"
  ],
  "permissions": [
    "core:event:default",
    "allow-get-state",
    "allow-tab-create",
    "allow-tab-close",
    "allow-tab-activate",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-stop",
    "allow-set-content-bounds",
    "allow-set-max-button-bounds",
    "allow-bookmarks-get",
    "allow-bookmark-add",
    "allow-bookmark-toggle",
    "allow-bookmark-add-folder",
    "allow-bookmark-rename",
    "allow-bookmark-remove",
    "allow-bookmark-move",
    "allow-bookmark-set-open",
    "allow-bookmarks-set-collapsed",
    "allow-take-notices",
    "allow-tab-open-url",
    "allow-tab-move",
    "allow-group-create",
    "allow-group-rename",
    "allow-group-set-collapsed",
    "allow-group-ungroup",
    "allow-tab-ungroup",
    "allow-tab-set-keep-alive",
    "allow-settings-get",
    "allow-settings-set",
    "allow-pick-download-dir",
    "allow-history-search",
    "allow-history-delete",
    "allow-history-clear",
    "allow-suggest",
    "allow-downloads-get",
    "allow-download-open",
    "allow-download-show",
    "allow-download-cancel",
    "allow-run-shortcut",
    "allow-popup-show",
    "allow-popup-hide",
    "allow-fullscreen-state",
    "allow-scripts-list",
    "allow-script-set-enabled",
    "allow-script-set-pinned",
    "allow-scripts-reload",
    "allow-scripts-open-folder",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "allow-sidebar-get",
    "allow-sidebar-set-collapsed",
    "allow-top-sites",
    "allow-permission-requests",
    "allow-permission-answer",
    "allow-apply-theme",
    "allow-update-get",
    "allow-update-install",
    "allow-log-ui"
  ]
}
